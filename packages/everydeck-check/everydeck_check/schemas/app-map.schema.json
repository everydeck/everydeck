     "start": {
      "$ref": "#/$defs/evidence"
     },
     "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "evidence"
      ],
      "properties": {
       "evidence": {
        "$ref": "#/$defs/evidence"
       },
       "write": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "table",
         "kind"
        ],
        "properties": {
         "table": {
          "$ref": "#/$defs/name"
         },
         "kind": {
          "enum": [
           "insert",
           "update",
           "delete"
          ]
         }
        }
       },
       "provider": {
        "$ref": "#/$defs/name"
       }
      }
     },
     "failure": {
      "$ref": "#/$defs/evidence"
     },
     "ends": {
      "type": "array",
      "maxItems": 6,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "evidence"
       ],
       "properties": {
        "id": {
         "$ref": "#/$defs/name"
        },
        "evidence": {
         "$ref": "#/$defs/evidence"
        }
       }
      }
     },
     "signals": {
      "type": "array",
      "maxItems": 12,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "step",
        "name",
        "evidence"
       ],
       "properties": {
        "step": {
         "type": "string",
         "pattern": "^(start|result|failure|end:[A-Za-z_][A-Za-z0-9_.-]{0,95})$"
        },
        "name": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "evidence": {
         "$ref": "#/$defs/evidence"
        }
       }
      }
     },
     "platforms": {
      "type": "array",
      "items": {
       "enum": [
        "web",
        "ios",
        "android",
        "desktop",
        "extension",
        "server"
       ]
      }
     },
     "shown": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "$ref": "#/$defs/shown"
      }
     },
     "purpose": {
      "enum": [
       "sign_up",
       "sign_in",
       "password_reset",
       "payment"
      ],
      "description": "the flow is the app's sign-up, sign-in, password reset or payment: these are always flows when the app has them (flow_candidates with required)"
     }
    }
   }
